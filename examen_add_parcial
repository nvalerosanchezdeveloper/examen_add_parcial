<?php
$pot = $_POST['pot'] ?? '';
$dinero = $_POST['dinero'] ?? '';
$postura = $_POST['postura'] ?? '';
$moneda = '';
$mensaje = '';

if(isset($_POST['reiniciar'])){
    $pot= 100;
    $dinero= '';
    $postura= '';
}
if (isset($_POST['apostar'])){
    $pot= (int)$pot;      
    $dinero= (int)$dinero;

    if ($pot<= 0){
        $mensaje= 'No queda bote. Pulsa Reiniciar.';
    } elseif ($dinero <= 0 || $dinero >= $pot) {
        $mensaje='La apuesta debe ser mayor que 0 y menor que el bote .';
    } elseif ($postura ==='') {
        $mensaje = 'Elige Cara o Cruz.';
    } else{
        $moneda= (rand(0,1) === 0) ?'CARA':'CRUZ';
        if($moneda === $postura){
            $pot += $dinero;              
            $mensaje = '¡Has acertado!';
        }else{
            $pot -= $dinero;              
            $mensaje = 'Has fallado.';
        }
    }
}
?>
