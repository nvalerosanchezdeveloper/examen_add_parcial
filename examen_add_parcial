<html lang= "es">
<head>
    <meta charset="UTF-8">
    <title>Cara o Cruz 2.0</title>
</head>
<body>

<form method="post">
    <fieldset>
        <title>Cara o Cruz 2.0</title>

        POT: <input type="text" value="<?= $pot ?>" readonly>
        <input type="hidden" name="pot" value="<?= $pot ?>"><br>

        Dinero: <input type="number" name="dinero" value="<?= $dinero ?>">
        <input type="radio" name="postura" value="CARA" <?= $postura === 'CARA' ? 'checked' : '' ?>> Cara
        <input type="radio" name="postura" value="CRUZ" <?= $postura === 'CRUZ' ? 'checked' : '' ?>> Cruz
 
        MONEDA: <input type="text" value="<?= $moneda ?>" readonly>
        <input type="submit" name="apostar" value="Apostar">
        <input type="submit" name="reiniciar" value="Reiniciar">
        <p><?= $mensaje ?></p>
    </fieldset>
</form>
</body>
</html>







 
